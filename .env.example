# FastAPI Application Configuration

# Application Settings
PROJECT_NAME="FastAPI Chart Application"
API_V1_STR="/api/v1"

# CORS Settings (comma-separated URLs)
# Example: "http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000"
BACKEND_CORS_ORIGINS=

# Database Configuration
DATABASE_URL=

# Security Settings
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Storage Engine Configuration
STORAGE_BASE_PATH=storage
TEMP_FILE_CLEANUP_HOURS=24
MAX_TEMP_FILE_SIZE_MB=100

# Legacy Storage Settings (deprecated - use storage engine)
CHART_SAVE_DIR=static/charts
CHART_URL_PATH=/static/charts

# File Upload Settings
MAX_UPLOAD_SIZE=10485760

# Template Configuration
TEMPLATES_DIR=app/templates
TEMPLATE_CACHE_SIZE=100

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
REPLICATE_API_TOKEN=

# AI Service Configuration
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=
AI_MAX_TOKENS_DEFAULT=1000
AI_TEMPERATURE_DEFAULT=0.7
AI_REQUEST_TIMEOUT=60

# Image Generation Defaults (optional)
# Leave empty to require explicit provider in API requests
IMAGE_DEFAULT_PROVIDER=
IMAGE_DEFAULT_MODEL=
