# Test Environment Variables
PROJECT_NAME="FastAPI Chart Application - Test"
API_V1_STR="/api/v1"

# CORS settings for testing
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:8000"]

# Database settings (use test database or sqlite for testing)
DATABASE_URL="sqlite:///./test.db"

# JWT Token settings
SECRET_KEY="test-secret-key-for-testing-only-not-secure"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage Engine Settings (will be overridden by fixtures)
STORAGE_BASE_PATH="test_storage"
TEMP_FILE_CLEANUP_HOURS=1
MAX_TEMP_FILE_SIZE_MB=10

# Legacy settings
CHART_SAVE_DIR="test_static/charts"
CHART_URL_PATH="/test_static/charts"

MAX_UPLOAD_SIZE=5242880  # 5 MB for tests

# Template Settings
TEMPLATES_DIR="app/templates"
TEMPLATE_CACHE_SIZE=10

# AI Settings (mock keys for testing)
OPENAI_API_KEY="test-openai-api-key-not-real"
ANTHROPIC_API_KEY="test-anthropic-api-key-not-real"